# Live API (Belmo). For local backend testing use your PC LAN IP instead.
EXPO_PUBLIC_API_URL=https://finpa-business.fideantech.com
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3001

# Supabase Auth (Dashboard → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Deep link after email confirmation (also add to Supabase Auth → URL Configuration → Redirect URLs)
EXPO_PUBLIC_AUTH_REDIRECT_URL=finpa-business://auth/callback

# Optional: force demo API/PIN chrome in a release build (never for store builds)
# EXPO_PUBLIC_SHOW_DEV_UI=1
