{
  "expo": {
    "name": "FINPA Business",
    "slug": "finpa-business",
    "scheme": "finpa-business",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B1210",
    "androidNavigationBar": {
      "backgroundColor": "#0B1210",
      "barStyle": "light-content"
    },
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1210"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.finpa.business.mobile",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "FINPA Business uses speech recognition so you can speak sales and expenses into chat.",
        "NSMicrophoneUsageDescription": "FINPA Business uses the microphone so you can speak sales and expenses into chat."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1210",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.finpa.business.mobile",
      "versionCode": 8,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      "expo-system-ui",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow FINPA Business to use the microphone so you can speak sales and expenses.",
          "speechRecognitionPermission": "Allow FINPA Business to use speech recognition so you can speak sales and expenses.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "65ee7ad7-fda8-464e-ac64-be096fc4a902"
      }
    },
    "owner": "fiddyboss"
  }
}
