PORT=3001
# VPS Postgres (leave unset to use in-memory store for local/dev)
DATABASE_URL=postgres://finpa_business_admin:CHANGE_ME@127.0.0.1:5432/finpa_business_prod
OPENROUTER_API_KEY=sk-or-v1-your-key
# Must be a free-tier OpenRouter model (ends with :free). Backend-env only.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Supabase Auth only (JWT validation). App data lives in DATABASE_URL.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_SECRET=change-me-to-a-long-random-string
# Comma-separated emails that can manage PINs in the app
SUPERADMIN_EMAILS=you@example.com
# Demo / review PINs (BUS-DEMO-*) — default off in production
ALLOW_DEMO_PINS=false
# Shared Paystack router (do not rename)
# FINPA_PAYSTACK_ROUTER_SECRET=
# FINPA_PAYSTACK_CALLBACK_URL=https://finpa-business.fideantech.com/api/checkout/paystack/success
# PAYSTACK_SECRET_KEY=
